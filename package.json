{
	"name": "n8n-nodes-umich-tdx",
	"version": "1.2.1",
	"description": "An n8n Node to connect to UM's TDX Proxy APIs.",
	"license": "MIT",
	"homepage": "https://workflows.umgpt.umich.edu/home/workflows",
	"keywords": [
		"n8n-community-node-package",
		"university-of-michigan",
		"tdx"
	],
	"author": {
		"name": "Chris Puzzuoli",
		"email": "cpuzzuol@umich.edu"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/umich-its-ai/n8n-nodes-umich-tdx"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"release:local": "dotenv -- n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/UmichTdxOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/UmichTdx/UmichTdx.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.33.0",
		"@types/node": "^25.2",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.29",
		"prettier": "^3.8",
		"release-it": "^19.2",
		"typescript": "^5.9"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
